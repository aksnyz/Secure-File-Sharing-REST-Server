<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Secure File Share Server</title>
    <style>
        body { font-family: sans-serif; margin: 40px; background-color: #f4f4f9; }
        .container { max-width: 600px; margin: auto; background: white; padding: 20px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); }
        h2 { border-bottom: 2px solid #5cb85c; padding-bottom: 10px; color: #333; }
        input[type="text"], input[type="password"], input[type="file"], button {
            width: 100%; padding: 10px; margin: 8px 0; display: inline-block; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;
        }
        button { background-color: #5cb85c; color: white; border: none; cursor: pointer; }
        button:hover { background-color: #4cae4c; }
        #auth-status { margin-top: 15px; font-weight: bold; padding: 10px; border-radius: 4px; }
        .token-display { word-break: break-all; font-size: 0.8em; margin-top: 5px; background-color: #eee; padding: 5px; border-radius: 3px;}
        .hidden { display: none; }
    </style>
</head>
<body>

<div class="container">
    <h1>Rust File Sharing Server</h1>
    <p>Status: <span id="auth-status" style="color:red;">Not logged in</span></p>

    <h2>1. Register & Login</h2>
    <form id="auth-form">
        <input type="text" id="username" placeholder="Username (e.g., student)" required>
        <input type="password" id="password" placeholder="Password (e.g., tajnehaslo)" required>
        <button type="button" onclick="handleAuth('/register')">Register</button>
        <button type="button" onclick="handleAuth('/login')">Login</button>
    </form>
    <div id="token-info" class="hidden">
        <p>Your Token:</p>
        <div class="token-display" id="token-value"></div>
    </div>

    <hr>

    <h2>2. Upload File (Requires Login)</h2>
    <form id="upload-form">
        <input type="file" id="file-input" required>
        <button type="button" onclick="uploadFile()">Upload</button>
    </form>
    <div id="upload-status" style="margin-top: 15px; font-weight: bold;"></div>

</div>

<script>
    let JWT_TOKEN = localStorage.getItem('jwt_token') || null;

    function updateStatus(status, color) {
        const authStatus = document.getElementById('auth-status');
        authStatus.textContent = status;
        authStatus.style.color = color;
    }

    // Initialize status on page load
    if (JWT_TOKEN) {
        updateStatus('Logged in (Token stored)', 'green');
        document.getElementById('token-value').textContent = JWT_TOKEN;
        document.getElementById('token-info').classList.remove('hidden');
    }

    async function handleAuth(endpoint) {
        const username = document.getElementById('username').value;
        const password = document.getElementById('password').value;
        const statusDiv = document.getElementById('auth-status');
        const tokenDiv = document.getElementById('token-value');
        const tokenInfo = document.getElementById('token-info');

        try {
            const response = await fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username, password })
            });

            const text = await response.text();

            if (response.ok) {
                if (endpoint === '/login') {
                    // Successful Login - store token
                    const data = JSON.parse(text);
                    JWT_TOKEN = data.token;
                    localStorage.setItem('jwt_token', JWT_TOKEN);
                    updateStatus('Login successful!', 'green');
                    tokenDiv.textContent = JWT_TOKEN;
                    tokenInfo.classList.remove('hidden');
                } else if (endpoint === '/register') {
                    // Successful Registration
                    updateStatus('Registration successful!', 'green');
                }
            } else {
                // Handle registration errors (e.g., username conflict)
                updateStatus(`Error (${response.status}): ${text}`, 'red');
                tokenInfo.classList.add('hidden');
            }
        } catch (error) {
            updateStatus(`Network Error: ${error.message}`, 'red');
        }
    }

    async function uploadFile() {
        if (!JWT_TOKEN) {
            document.getElementById('upload-status').textContent = 'Error: Please log in first.';
            document.getElementById('upload-status').style.color = 'red';
            return;
        }

        const fileInput = document.getElementById('file-input');
        const statusDiv = document.getElementById('upload-status');
        const file = fileInput.files[0];

        if (!file) {
            statusDiv.textContent = 'Error: Please select a file.';
            statusDiv.style.color = 'red';
            return;
        }

        const formData = new FormData();
        formData.append('file', file); // 'file' is the field name Rust expects

        try {
            statusDiv.textContent = 'Uploading...';
            statusDiv.style.color = 'blue';

            const response = await fetch('/file/upload', {
                method: 'POST',
                // IMPORTANT: Do NOT set 'Content-Type' header for FormData. The browser handles it automatically!
                headers: {
                    'Authorization': `Bearer ${JWT_TOKEN}` // Send the token for authentication
                },
                body: formData
            });

            const text = await response.text();

            if (response.ok) {
                statusDiv.textContent = 'Upload successful! ' + text;
                statusDiv.style.color = 'green';
            } else {
                statusDiv.textContent = `Upload Error (${response.status}): ${text}`;
                statusDiv.style.color = 'red';
            }
        } catch (error) {
            statusDiv.textContent = `Network Error: ${error.message}`;
            statusDiv.style.color = 'red';
        }
    }
</script>

</body>
</html>